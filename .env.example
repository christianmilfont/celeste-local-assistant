# Ollama Configuration (use o nome exato de `ollama list`)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_KEEP_ALIVE=30m

# Whisper Configuration (faster-whisper local; Python do .venv por padrão)
WHISPER_MODEL=base
WHISPER_LANGUAGE=pt
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# WHISPER_PYTHON=.venv/Scripts/python.exe
WHISPER_TIMEOUT_MS=60000

# Piper TTS Configuration (Linux/macOS)
PIPER_MODEL=pt_BR-glow_tts
PIPER_VOICE_PATH=

# Voz: "neural" (Kokoro, local, natural) ou "system" (voz do Windows)
TTS_ENGINE=neural
# pf_dora (feminina pt-BR) | pm_alex | pm_santa (masculinas pt-BR)
KOKORO_VOICE=pf_dora
# 0.9 = mais calma | 1.0 = normal
KOKORO_SPEED=0.95
KOKORO_MODEL=./models/kokoro/kokoro-v1.0.onnx
KOKORO_VOICES=./models/kokoro/voices-v1.0.bin

# Voz do Windows, usada como reserva (vazio = primeira voz pt-BR instalada)
TTS_VOICE=
TTS_RATE=0

# Voice input (push-to-talk)
VOICE_MAX_RECORDING_MS=30000
VOICE_MIN_RECORDING_MS=400
VOICE_SILENCE_THRESHOLD=400

# WhatsApp Configuration
WHATSAPP_SESSION_PATH=./sessions
WHATSAPP_AUTH_TIMEOUT=60000

# Database Configuration
DATABASE_PATH=./celeste.db

# Logging Configuration (terminal mostra só LOG_CONSOLE_LEVEL; o arquivo recebe LOG_LEVEL)
LOG_LEVEL=info
LOG_CONSOLE_LEVEL=warn
LOG_FILE=./logs/celeste.log

# Audio Configuration
AUDIO_TEMP_DIR=./tmp/audio
KEEP_AUDIO_FILES=false

# AI Configuration
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=500
AI_TIMEOUT_MS=60000
# Usa o LLM para redigir a resposta a partir do que você ditou (false = envia o texto ditado)
AI_REWRITE_REPLIES=true

# Avatar 2D (página servida pela Celeste; abre numa janela própria do Edge/Chrome)
AVATAR_ENABLED=true
# 127.0.0.1 = só este computador; 0.0.0.0 = acessível por outro dispositivo da rede (display dedicado)
AVATAR_HOST=127.0.0.1
AVATAR_PORT=7717
# app = janela sem barras (Edge/Chrome --app) | browser = navegador padrão | none = não abre
AVATAR_WINDOW=app
AVATAR_FULLSCREEN=false

# Smart TVs na rede local (Samsung Tizen)
TV_ENABLED=true
# Apelidos para os comandos de voz: "<ip-ou-id>=da sala;<ip-ou-id>=do quarto"
TV_ALIASES=
